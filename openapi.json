{
  "openapi": "3.1.0",
  "info": {
    "title": "ChatGPT Agnes Bridge",
    "version": "1.1.0",
    "description": "Generate vertical videos through the Agnes Railway backend."
  },
  "servers": [
    { "url": "https://chatgpt-agnes-bridge-production.up.railway.app" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/api/chatgpt/health": {
      "get": {
        "operationId": "health",
        "summary": "Check bridge health",
        "responses": { "200": { "description": "Healthy" } }
      }
    },
    "/api/chatgpt/generate": {
      "post": {
        "operationId": "generateVideo",
        "summary": "Start Agnes video generation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Task created" },
          "400": { "description": "Invalid request" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/chatgpt/status/{task_id}": {
      "get": {
        "operationId": "getVideoStatus",
        "summary": "Get video generation status",
        "parameters": [{
          "name": "task_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }],
        "responses": { "200": { "description": "Task status" }, "401": { "description": "Unauthorized" } }
      }
    },
    "/api/chatgpt/video/{task_id}": {
      "get": {
        "operationId": "downloadVideo",
        "summary": "Download generated MP4",
        "parameters": [{
          "name": "task_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }],
        "responses": { "200": { "description": "MP4 video", "content": { "video/mp4": {} } }, "401": { "description": "Unauthorized" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "GenerateRequest": {
        "type": "object",
        "required": ["prompt"],
        "properties": {
          "prompt": { "type": "string", "description": "Detailed visual prompt for the video" },
          "duration": { "type": "integer", "default": 5, "minimum": 1, "maximum": 60 },
          "resolution": { "type": "string", "default": "768x1152" },
          "mode": { "type": "string", "default": "t2v" }
        }
      }
    }
  }
}
